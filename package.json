{
  "name": "autocut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KI-gestützte Video-Editing-Pipeline (Prototyp, Kunde: Thorsten Wittmann)",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "autocut": "./src/cli.ts"
  },
  "scripts": {
    "autocut": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "ui": "tsx src/cli.ts ui",
    "test:e2e": "tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@remotion/bundler": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "commander": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
