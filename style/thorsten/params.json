      "_quelle": "style.json untertitel.woerter_pro_einblendung. Das Kriterium bezieht sich auf die Anzeigedauer des zuletzt angehaengten Wortes; so ergibt es die Gruppen aus Reel 48 ('Wenn ich mein Vermögen', 'auf die nächsten', 'würde ich mir')."
    },
    "timing": {
      "start_vorlauf_frames": 1,
      "nachlauf_luecke_s": 0.35,
      "nachlauf_s": 0.18,
      "wipe_vorlauf_frames": 4,
      "_quelle": "style.json untertitel.timing, hervorhebungen_gold.typen.wipe"
